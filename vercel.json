{
  "cleanUrls": false,
  "headers": [
    {"source": "/(site.css|js/(.*))", "headers": [{"key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=604800"}]},
    {"source": "/ops-q8m4x2/(.*)", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"}, {"key": "Cache-Control", "value": "no-store"}]},
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://*.supabase.co https://lh3.googleusercontent.com; media-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "Permissions-Policy", "value": "geolocation=(self), microphone=(self), camera=(), payment=(), usb=(), bluetooth=(), interest-cohort=()"},
        {"key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains"},
        {"key": "Cross-Origin-Opener-Policy", "value": "same-origin"},
        {"key": "Cross-Origin-Resource-Policy", "value": "same-origin"}
      ]
    },
    {"source": "/app/sw.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/(index.html|app/index.html|app/js/(.*)|app/css/(.*)|app/manifest.webmanifest)", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/app/manifest.webmanifest", "headers": [{"key": "Content-Type", "value": "application/manifest+json"}]}
  ]
}
